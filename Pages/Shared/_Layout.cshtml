@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    @{
        var shouldNoIndex = Context.Items["SeoNoIndex"] as bool? == true;
        var description = ViewData["Description"] as string;
        var canonicalPath = ViewData["CanonicalPath"] as string;
        var canonicalBaseUrl = Context.RequestServices
            .GetRequiredService<IConfiguration>()["Site:CanonicalBaseUrl"]!
            .TrimEnd('/');
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    @if (!string.IsNullOrWhiteSpace(description))
    {
        <meta name="description" content="@description" />
    }
    @if (shouldNoIndex)
    {
        <meta name="robots" content="noindex" />
    }
    else if (!string.IsNullOrWhiteSpace(canonicalPath))
    {
        <link rel="canonical" href="@(canonicalBaseUrl + canonicalPath)" />
    }
    <environment exclude="Development">
        <link rel="stylesheet" href="~/vendor/silktide-consent-manager/silktide-consent-manager.css" asp-append-version="true" />
    </environment>
    <link rel="stylesheet" href="~/css/consent.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <main role="main">
        @RenderBody()
    </main>

    <nav class="site-policy-links" aria-label="Site policies"><a href="/cookies">Cookie policy</a></nav>
    <environment exclude="Development">
        <script src="~/vendor/silktide-consent-manager/silktide-consent-manager.js" asp-append-version="true" defer></script>
        <script src="~/js/consent.js" asp-append-version="true" defer></script>
    </environment>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
